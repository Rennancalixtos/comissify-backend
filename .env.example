# ════════════════════════════════════════════════════════════════════════
# Comissify — Environment Configuration
# Copie este arquivo para .env e preencha os valores antes de iniciar.
# ════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────
APP_NAME=Comissify
APP_ENV=production
APP_KEY=                               # php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://seudominio.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# ─── Logging ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database (MySQL 8) ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comissify
DB_USERNAME=
DB_PASSWORD=

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Cache & Session & Queue ────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ─── Laravel Horizon ────────────────────────────────────────────────────
HORIZON_ENVIRONMENT=production

# ─── Shopee Affiliate API ───────────────────────────────────────────────
SHOPEE_API_BASE_URL=https://open-api.affiliate.shopee.com.br/graphql

# ─── Pinterest ──────────────────────────────────────────────────────────
PINTEREST_SCRAPER_KEY=

# ─── Binários (ajustar conforme servidor) ───────────────────────────────
PYTHON_PATH=/usr/bin/python3
YTDLP_PATH=/usr/local/bin/yt-dlp
VIDEO_DOWNLOAD_TIMEOUT=120
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe

# ─── AI (para geração de texto/imagem) ──────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.7

# ─── Negócio ────────────────────────────────────────────────────────────
NEW_USER_TOKEN_BONUS=5.00              # Bônus de créditos para novos usuários

# ─── Mail ───────────────────────────────────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@comissify.com.br
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=                        # re_xxxxxxxxxxxx
