# Imagem leve do Comissify em modo demonstração (vitrine de portfólio).
# SQLite no lugar de MySQL, sem Redis/Horizon, sem yt-dlp/ffmpeg.
# Pensada para o plano grátis do Render (512 MB de RAM).

# ── 1. Assets (Vite) ─────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY vite.config.js tailwind.config.js postcss.config.js ./
COPY resources ./resources
COPY app ./app
RUN npm run build

# ── 2. App PHP ───────────────────────────────────────────────────────────────
FROM php:8.3-fpm-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx supervisor unzip libpng-dev libjpeg62-turbo-dev libwebp-dev libzip-dev libsqlite3-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install pdo_sqlite gd zip bcmath pcntl opcache \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY docker/demo/php.ini /usr/local/etc/php/conf.d/demo.ini

WORKDIR /var/www

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --no-interaction --prefer-dist \
        --ignore-platform-req=ext-redis

COPY . .
COPY --from=assets /app/public/build ./public/build

RUN mkdir -p storage/logs storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && composer dump-autoload --optimize --no-dev \
    && chown -R www-data:www-data storage bootstrap/cache database

# Nginx: mesma config de produção (CSP, headers), escutando na porta do Render
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

COPY docker/demo/supervisord.conf /etc/supervisor/supervisord.conf
COPY docker/demo/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV PORT=10000
EXPOSE 10000
CMD ["/usr/local/bin/entrypoint.sh"]
